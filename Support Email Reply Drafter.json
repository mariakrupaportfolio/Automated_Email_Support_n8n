    {
      "parameters": {
        "jsCode": "const doc = $input.first().json;\nlet text = '';\nconst links = [];\nconst seen = new Set();\nfunction walk(content) {\n  for (const el of content || []) {\n    if (el.paragraph) {\n      for (const pe of el.paragraph.elements || []) {\n        const run = pe.textRun;\n        if (!run) continue;\n        text += run.content || '';\n        const url = run.textStyle && run.textStyle.link && run.textStyle.link.url;\n        if (url && !seen.has(url)) {\n          seen.add(url);\n          links.push({ label: (run.content || '').trim(), url });\n        }\n      }\n    } else if (el.table) {\n      for (const row of el.table.tableRows || []) {\n        for (const cell of row.tableCells || []) {\n          walk(cell.content);\n          text += ' | ';\n        }\n        text += '\\n';\n      }\n    } else if (el.tableOfContents) {\n      walk(el.tableOfContents.content);\n    }\n  }\n}\nwalk(doc.body && doc.body.content);\nconst urlRegex = /https?:\\/\\/[^\\s)\\]>\"']+/g;\nfor (const m of text.match(urlRegex) || []) {\n  if (!seen.has(m)) {\n    seen.add(m);\n    links.push({ label: m, url: m });\n  }\n}\nconst linkList = links.map((l, i) => (i + 1) + '. ' + (l.label || l.url) + ' -> ' + l.url).join('\\n');\nreturn [{ json: { content: text.trim(), links, linkList: linkList || '(no links in the document)' } }];"
      },
      "id": "57ebf202-0460-4087-9989-81826fec997b",
      "name": "Extract Text and Links",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
