      "id": "19f46309-0e99-4b41-9de7-2d2ba9d3b8d4",
      "name": "Get Last 24h Enquiries",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        224,
        112
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.topic);\nconst sentiments = { positive: 0, neutral: 0, negative: 0 };\nconst topics = {};\nfor (const r of rows) {\n  const s = String(r.sentiment || 'neutral').toLowerCase();\n  sentiments[s in sentiments ? s : 'neutral']++;\n  const t = r.topic || 'Other';\n  if (!topics[t]) topics[t] = { count: 0, negative: 0 };\n  topics[t].count++;\n  if (s === 'negative') topics[t].negative++;\n}\nconst topicLines = Object.entries(topics).sort((a, b) => b[1].count - a[1].count)\n  .map(([t, v]) => '- ' + t + ': ' + v.count + (v.negative ? ' (' + v.negative + ' negative)' : '')).join('\\n');\nconst details = rows.map(r => '- [' + r.sentiment + '] ' + r.topic + ' | ' + r.subject + ' | ' + r.summary).join('\\n');\nreturn [{ json: { total: rows.length, sentiments, topicLines: topicLines || '(none)', details: details || '(no enquiries)' } }];"
      },
      "id": "44860f09-db91-42be-b1ff-f7af92ef002d",
      "name": "Build Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        112
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer support enquiries from the last 24 hours.\n\nTotal: {{ $json.total }}\nSentiment: positive {{ $json.sentiments.positive }}, neutral {{ $json.sentiments.neutral }}, negative {{ $json.sentiments.negative }}\n\nBy topic:\n{{ $json.topicLines }}\n\nIndividual enquiries:\n{{ $json.details }}",
        "messages": {
          "messageValues": [
            {
              "message": "You write a short daily customer-support report in English as simple HTML (use <h3>, <p>, <ul>, <li>, <b> only). Sections: 1) Overview - total enquiries and the sentiment split (positive / neutral / negative). 2) Main enquiries - the top topics with counts and what people were asking. 3) Issues to watch - recurring problems and anything negative, with a one-line suggestion each (e.g. add the answer to the FAQ doc). If total is 0, just say there were no customer enquiries in the last 24 hours. Use only the data given. Output only the HTML."
            }
          ]
        },
        "batching": {}
      },
